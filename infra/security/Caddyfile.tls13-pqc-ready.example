# Caddy TLS 1.3 readiness example for staging and edge review.
# Browser-facing hybrid PQC is ecosystem-dependent; do not force OQS/liboqs here.
# Caddy built with Go 1.24+ offers X25519MLKEM768 in its default TLS 1.3 curve
# preferences. Do not disable it, and verify the negotiated group rather than
# assuming the default is active.

example.invalid {
  tls {
    protocols tls1.3
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
  }

  reverse_proxy 127.0.0.1:5000
}
