# Hosted production template. Every var here is actually consumed by app/src
# (import.meta.env). CI injects the real values for hosted lanes (see
# .github/workflows/deploy-netlify.yml); this file documents the full surface
# for self-hosted or preview environments. Build-time-only vars
# (VITE_RELEASE_*, VITE_DEPLOY_TARGET) are injected by CI and are not listed.

# --- API ---
VITE_API_URL=/api

# --- Firebase ---
VITE_FIREBASE_API_KEY=example
VITE_FIREBASE_AUTH_DOMAIN=example.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=example-project
VITE_FIREBASE_STORAGE_BUCKET=example-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:example
VITE_FIREBASE_MEASUREMENT_ID=G-EXAMPLE
VITE_FIREBASE_CONFIG=
VITE_FIREBASE_WEB_CONFIG=
VITE_FIREBASE_DISABLE_SOCIAL_AUTH=false
VITE_FIREBASE_ANALYTICS_ENABLED=
VITE_FIREBASE_FORCE_REDIRECT_SOCIAL_AUTH=
VITE_FIREBASE_DESKTOP_REDIRECT_SOCIAL_AUTH=
VITE_FIREBASE_ENABLE_MICROSOFT_AUTH=true
VITE_FIREBASE_ENABLE_APPLE_AUTH=false
VITE_MOBILE_NATIVE_SOCIAL_AUTH_ENABLED=false
VITE_MOBILE_FIREBASE_PHONE_OTP_ENABLED=false

# --- Auth / security ---
VITE_AUTH_SHIELD_DPOP_ENABLED=false
VITE_ALIEN_OTP_ENABLED=false
VITE_PERSIST_TRUSTED_DEVICE_SESSION=
VITE_ADMIN_SECURITY_STATE_ENGINE_V2=false
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_ENABLED=
VITE_AUTH_TURNSTILE_ENABLED=

# --- Frontend fleet targets ---
VITE_VERCEL_FRONTEND_URL=https://example.vercel.app
VITE_NETLIFY_FRONTEND_URL=https://example.netlify.app
VITE_RAILWAY_FRONTEND_URL=https://example.up.railway.app
VITE_GATEWAY_FRONTEND_URL=https://aura-gateway.vercel.app

# --- UX toggles ---
VITE_WELCOME_CURTAIN_ENABLED=true
VITE_WELCOME_CURTAIN_SOUND_ENABLED=true
VITE_LENIS_ENABLED=

# --- Telemetry (injected by CI when enabled) ---
VITE_SENTRY_ENABLED=
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=
VITE_DD_ENABLED=
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
VITE_DD_SITE=us5.datadoghq.com
VITE_DD_SERVICE=
VITE_DD_ENV=
VITE_DD_VERSION=
VITE_DD_SESSION_SAMPLE_RATE=
VITE_DD_SESSION_REPLAY_SAMPLE_RATE=
VITE_DD_TRACK_INTERACTIONS=

# --- i18n ---
VITE_I18N_FORMATJS_ENABLED=
VITE_I18N_RUNTIME_TRANSLATION_ENABLED=
VITE_I18N_STABLE_UI_RUNTIME_TRANSLATION_ENABLED=
VITE_I18N_PSEUDO_LOCALE_ENABLED=
