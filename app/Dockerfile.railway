# Aura storefront on Railway — Vite SPA served by Caddy (see app/Caddyfile,
# generated by app/scripts/sync_vercel_configs.mjs — do not hand-edit Caddyfile).
#
# Railway builds this image from the REPO ROOT (Root Directory left empty,
# Dockerfile Path `app/Dockerfile.railway`) because the Vite build graph reaches
# two repo-root inputs outside app/: ../../config/desktopAuthLoopback.cjs and
# ../../../shared/assistantCapabilities.json. Every other storefront lane builds
# from the repo root for the same reason.
FROM node:24-alpine AS build

ENV NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false

WORKDIR /app

COPY app/package.json app/package-lock.json ./

RUN npm ci

COPY app/ ./

# Repo-root inputs imported by app/config/vercelRoutingContract.mjs and
# app/src/utils/assistantCommands.js, placed at the paths those specifiers
# resolve to from /app.
COPY config/desktopAuthLoopback.cjs /config/desktopAuthLoopback.cjs
COPY shared/assistantCapabilities.json /shared/assistantCapabilities.json

# Cache-buster: Railway's remote layer cache has reused `RUN npm run build`
# even across releases with changed sources, baking a stale dist/ (built
# without the release VITE_* vars) into new images. This per-release id is
# written by deploy-railway.sh / rollback-railway.sh staging, so the layer
# hash changes every release and the Vite build below always re-executes.
# The file itself is never bundled.
COPY app/.railway-build-id ./.railway-build-id

# Build env: `railway up` Docker builds do not receive service variables, so
# the release contract is staged as app/.railway-build-env (a plain KEY=value
# file — deliberately NOT a dotenv auto-load name, since those are gitignored
# and would never reach the builder) and sourced here. Sourcing overwrites
# same-named variables, but the file carries the exact contract pushed to the
# host by the same builder, so either source yields equal bytes.
RUN if [ -f ./.railway-build-env ]; then set -a; . ./.railway-build-env; set +a; fi; npm run build

FROM caddy:2-alpine

# Trivy DS-0002: never run the edge container as root. The build steps above
# stay root-owned; only the final runtime drops privileges.
RUN addgroup -S caddy && adduser -S -G caddy caddy

WORKDIR /app

COPY app/Caddyfile ./

RUN caddy fmt Caddyfile --overwrite \
    && chown caddy:caddy /app/Caddyfile

COPY --from=build --chown=caddy:caddy /app/dist ./dist

EXPOSE 3000

# Trivy DS-0026: the Railway platform already healthchecks `/` on deploy;
# keep an in-container probe too (curl ships in caddy:2-alpine) so local
# `docker ps` and orchestrators see real readiness.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl --fail --silent --max-time 4 http://127.0.0.1:${PORT:-3000}/ || exit 1

USER caddy

CMD ["caddy", "run", "--config", "Caddyfile", "--adapter", "caddyfile"]
