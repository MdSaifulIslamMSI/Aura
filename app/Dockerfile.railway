# Aura storefront on Railway — Vite SPA served by Caddy (see app/Caddyfile,
# generated by app/scripts/sync_vercel_configs.mjs — do not hand-edit Caddyfile).
# Build runs the same `npm ci && npm run build` as the Render lane; host-side
# VITE_* env must match the CI build contract (see verify_host_env_parity.mjs).
# Railway service settings: Root Directory `app`, Config File `/app/railway.toml`,
# Dockerfile Path `Dockerfile.railway`, Watch Paths `/app/**`.
FROM node:24-alpine AS build

ENV NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . ./

RUN npm run build

FROM caddy:2-alpine

# Trivy DS-0002: never run the edge container as root. The build steps above
# stay root-owned; only the final runtime drops privileges.
RUN addgroup -S caddy && adduser -S -G caddy caddy

WORKDIR /app

COPY Caddyfile ./

RUN caddy fmt Caddyfile --overwrite \
    && chown caddy:caddy /app/Caddyfile

COPY --from=build --chown=caddy:caddy /app/dist ./dist

EXPOSE 3000

# Trivy DS-0026: the Railway platform already healthchecks `/` on deploy;
# keep an in-container probe too (curl ships in caddy:2-alpine) so local
# `docker ps` and orchestrators see real readiness.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl --fail --silent --max-time 4 http://127.0.0.1:${PORT:-3000}/ || exit 1

USER caddy

CMD ["caddy", "run", "--config", "Caddyfile", "--adapter", "caddyfile"]
