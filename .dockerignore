.git
.gitignore
.venv
__pycache__
*.pyc
*.pyo
*.pyd
*.log
**/.env
**/.env.*
# Exception: the CI-staged Railway build contract (scripts/deploy-railway.sh
# writes app/.env.production into the upload staging area only; it is never
# committed). Without this, the Vite build inside `railway up` Docker builds
# silently misses every VITE_* var and bakes unversioned bytes.
!app/.env.production
.student-pack.local.env
!.env.example
!**/*.example.env
!**/*.env.example
**/.aws
**/.gcp
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
.cache_ggshield
.codex
.agents
.run-logs
.staging
.trivycache
.vercel
.netlify
.firebase
.vscode
.idea
.playwright-mcp
.sentryclirc
.openbao-token
**/.terraform
**/*.tfstate
**/*.tfstate.*
**/playwright-report
**/test-results
**/coverage
*.payment.local.env
payment-secrets*.env
**/*.mobileprovision
**/*.base64
**/*.crt
**/*.csr
# The storefront lanes build the frontend from the repo root (Vercel, Netlify,
# AWS, Render, and Railway all run app/ scripts against the checked-out repo),
# and the Railway image also needs config/desktopAuthLoopback.cjs and
# shared/assistantCapabilities.json in its context. Native projects, logs, and
# build output under app/ stay excluded; every secret pattern below is intact.
app/android
app/ios
app/log
app/.run-logs
app/.netlify
app/.vercel
desktop
docs
gateway
gitops
infra
k8s
charts
observability
plugins
tests
node_modules
app/node_modules
server/node_modules
server/data
app/dist
desktop-release
generated
output
artifacts
reports
security-reports
server/coverage
app/coverage
server/uploads
server/tests
server/seeders
server/test_output*
server/test_results*.json
server/test-db-users.js
server/test-prod-*.js
server/test-redis.js
server/public
server/*.md
server/Dockerfile*
server/.cache
server/run-logs
server/generated
server/.assistant
server/.codex-runtime
server/.mongodb-binaries
server/.vercel
